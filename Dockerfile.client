FROM python:3.12.6

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV SECRET_KEY=virtual-bank-build-only-placeholder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libpq-dev gcc --no-install-recommends \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN useradd -m appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=appuser:appuser . .

USER appuser
WORKDIR /app/clients

RUN mkdir -p staticfiles && chmod -R 755 staticfiles
RUN python manage.py collectstatic --noinput

EXPOSE 8040

COPY --chown=appuser:appuser docker-client-entrypoint.sh /app/docker-client-entrypoint.sh
RUN chmod +x /app/docker-client-entrypoint.sh

ENTRYPOINT ["/app/docker-client-entrypoint.sh"]
CMD ["sh", "-c", "daphne -b 0.0.0.0 -p ${PORT:-8040} virtual_bank.asgi:application"]

# Database configuration
DB_NAME=virtualbank
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Django settings
SECRET_KEY=your-secret-key-here
# DJANGO_SECRET_KEY is also accepted as a legacy fallback
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Superuser (optional)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# API and Client URLs and Ports
API_HOST=localhost
API_PORT=8030
API_URL=http://${API_HOST}:${API_PORT}
CLIENT_HOST=localhost
CLIENT_PORT=8040
CLIENT_URL=http://${CLIENT_HOST}:${CLIENT_PORT}
ALLOWED_HOSTS=localhost:8030,127.0.0.1:8030,localhost:8040,127.0.0.1:8040,${API_HOST}:${API_PORT},${CLIENT_HOST}:${CLIENT_PORT}

# Vector Smart Chain (VSG, chain ID 420042)
# Set a trusted HTTPS JSON-RPC endpoint. Never add a private key or seed phrase.
VSC_RPC_URL=https://rpc.vscblockchain.org
# Secondary public endpoint; the backend verifies chain ID 420042 before using it.
VSC_RPC_FALLBACK_URLS=https://420042.rpc.thirdweb.com
# Official Etherscan-compatible explorer API for native VSG transaction history.
VSC_HISTORY_API_URL=https://explorer.vscblockchain.org/api
